@article{jain2026privacy,
  bibtex_show={true},
  abbr={arXiv},
  title={Privacy Without Regret: Differentially Private Inference-Time Alignment},
  author={Jain, Ishi and Bhattad, Nandini and Chowdhury, Sayak Ray},
  abstract={Best-of-N sampling is a widely used inference-time alignment strategy for large language models, but it is prone to reward hacking and provides no privacy protection for the human preference data used to train the reward model. We introduce two calibrated-noise mechanisms that add differential privacy to Best-of-N selection. PrivBoN shows that Gumbel noise at an appropriate scale simultaneously provides epsilon-differential privacy and implements KL-regularized alignment. PrivITP (Private Inference-Time Pessimism) combines chi-squared-regularized rejection sampling with a two-phase Gaussian mechanism, achieving (epsilon, delta)-DP with a privacy cost independent of the number of responses n. Both methods are scaling-monotonic, and experiments across multiple language and reward models show notable performance gains in strong-privacy settings.},
  journal={arXiv preprint arXiv:2608.26324},
  year={2026},
  arxiv={2608.26324},
  url={https://arxiv.org/abs/2608.26324},
  html={https://arxiv.org/abs/2608.26324},
  selected={true}
}
